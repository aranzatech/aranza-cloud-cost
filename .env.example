# Only the location of the non-secret configuration plus secrets belong here.
# Do not commit the real .env file.
ARANZA_CLOUD_CONFIG_FILE=config/cloud-costs.toml

# Secrets for enabled notification destinations.
ARANZA_CLOUD_SLACK_WEBHOOK_URL=
ARANZA_CLOUD_TELEGRAM_BOT_TOKEN=

# Azure credentials. Prefer managed identity in deployed workloads.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# GCP credentials. Prefer Workload Identity in deployed workloads.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# Optional deployment-only overrides. They win over cloud-costs.toml.
# ARANZA_CLOUD_BUDGET=
# ARANZA_CLOUD_SLACK_ENABLED=false
# ARANZA_CLOUD_TELEGRAM_ENABLED=false
# ARANZA_CLOUD_TELEGRAM_CHAT_ID=
